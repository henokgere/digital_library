# Copy this file to `.env` and fill in real values for local development.
# In production (Render, etc.) set these as real environment variables.
# ASP.NET Core's configuration system maps `GoogleAuth__ClientId` to `GoogleAuth:ClientId`.

GoogleAuth__ClientId=your-client-id.apps.googleusercontent.com
GoogleAuth__ClientSecret=your-client-secret
GoogleAuth__RedirectUri=https://your-host/Account/callback
