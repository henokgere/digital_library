<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Library</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="library-shell">
    <header class="library-topbar">
        <div class="library-topbar__inner">
            @{
                var currentUser = Context.Session.GetString("Username");
            }
            <a class="library-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="library-brand__eyebrow">Digital Library</span>
                <span class="library-brand__title">Shelf & Story</span>
            </a>
            <nav class="library-nav" aria-label="Primary">
                @if (currentUser is not null)
                {
                    <a class="library-nav__link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="library-nav__link" asp-area="" asp-controller="Book" asp-action="Index">Catalog</a>
                    <a class="library-nav__link" asp-area="" asp-controller="Book" asp-action="AddBook">Add Book</a>
                    <span class="library-nav__user">Hi, @currentUser</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="library-nav__logout">
                        <button type="submit" class="library-nav__link library-nav__link--button">Logout</button>
                    </form>
                }
                else
                {
                    <a class="library-nav__link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="library-nav__link" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                }
            </nav>
        </div>
    </header>
    <div class="library-page">
        <main role="main" class="library-main">
            @if (TempData["StatusMessage"] is string statusMessage)
            {
                <div class="library-flash" role="status">@statusMessage</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="library-footer">
        <div class="library-footer__inner">
            <span>&copy; 2026 Digital Library</span>
            <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
