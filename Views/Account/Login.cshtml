@model digital_library.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="book-panel auth-panel">
    <div class="book-panel__header">
        <div>
            <p class="book-panel__eyebrow">Welcome back</p>
            <h1 class="book-panel__title">Sign in</h1>
            <p class="book-panel__subtitle">Sign in to manage the library catalog.</p>
        </div>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" class="book-form">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="book-form__summary"></div>

        <div class="book-form__field">
            <label asp-for="UsernameOrEmail"></label>
            <input asp-for="UsernameOrEmail" class="library-input" autocomplete="username" />
            <span asp-validation-for="UsernameOrEmail" class="book-form__error"></span>
        </div>

        <div class="book-form__field">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="library-input" autocomplete="current-password" />
            <span asp-validation-for="Password" class="book-form__error"></span>
        </div>

        <div class="book-form__actions">
            <button type="submit" class="library-button library-button--primary">Sign In</button>
        </div>
    </form>

    <div class="auth-divider"><span>or</span></div>

    <a asp-controller="Account" asp-action="GoogleLogin" class="library-button google-button">
        <svg class="google-button__icon" width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
            <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" />
            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" />
        </svg>
        Continue with Google
    </a>

    <p class="auth-switch">
        Don't have an account?
        <a asp-controller="Account" asp-action="Register">Create one</a>
    </p>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
